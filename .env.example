# =============================================================================
# DeepTutor-Plus Environment Template
# =============================================================================
# Merged from DeepTutor + Open-TutorAi
# Copy this file to `.env` and fill in your values.
#
# Sections:
#   1. Ports
#   2. LLM                       (required for chat)
#   3. Embedding                 (required for knowledge base / RAG)
#   4. Web Search                (optional)
#   5. Avatar & TTS              (Open-TutorAi features)
#   6. MoA (Multi-model)         (Open-TutorAi features)
#   7. Networking & Frontend     (Docker / remote deployments)
#   8. Security
#   9. Authentication & Multi-User
#   10. Storage / Attachments     (optional)

# --------------------------------------------------------------------------
# 1. Ports
# --------------------------------------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=3782
POCKETBASE_PORT=8090

# --------------------------------------------------------------------------
# 2. LLM (Required)
# --------------------------------------------------------------------------
# Supported bindings: openai, anthropic, deepseek, gemini, azure_openai,
# nvidia_nim, lm_studio, ollama, vllm, openrouter, siliconflow, dashscope, ...
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxx
LLM_HOST=https://api.openai.com/v1
LLM_API_VERSION=
LLM_REASONING_EFFORT=

# --------------------------------------------------------------------------
# 3. Embedding (Required for knowledge base / RAG)
# --------------------------------------------------------------------------
# Supported bindings: openai, azure_openai, cohere, jina, ollama, vllm,
# siliconflow, aliyun, gemini, custom.
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_HOST=https://api.openai.com/v1/embeddings
EMBEDDING_API_VERSION=
EMBEDDING_DIMENSION=
EMBEDDING_SEND_DIMENSIONS=

# Provider API Keys
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=
GEMINI_API_KEY=

# --------------------------------------------------------------------------
# 4. Web Search (Optional)
# --------------------------------------------------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=
SEARCH_PROXY=

# --------------------------------------------------------------------------
# 5. Avatar & TTS (Open-TutorAi Features)
# --------------------------------------------------------------------------
# Enable Avatar chat mode
AVATAR_ENABLED=true

# Kokoro TTS Settings
KOKORO_TTS_ENABLED=true
KOKORO_MODEL_PATH=./web/public/pyodide/kokoro

# Avatar 3D Model Settings
AVATAR_MODEL_PATH=./web/public/avatars
DEFAULT_AVATAR=student-avatar.glb

# WebGPU for TTS acceleration (auto-detected, set to false to force WASM)
TTS_USE_WEBGPU=true

# --------------------------------------------------------------------------
# 6. MoA - Multi-model Agent (Open-TutorAi Features)
# --------------------------------------------------------------------------
# Enable Mixture of Agents for parallel model responses
MOA_ENABLED=true

# MoA models to use (comma-separated)
MOA_MODELS=gpt-4o,claude-3-opus,gemini-1.5-pro

# MoA merge strategy: parallel, sequential, or vote
MOA_STRATEGY=parallel

# --------------------------------------------------------------------------
# 7. Ollama Integration
# --------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------------------------------------
# 8. Networking & Frontend (Docker / remote deployments)
# --------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_EXTERNAL=
NEXT_PUBLIC_API_BASE=
CORS_ORIGIN=
CORS_ORIGINS=

# --------------------------------------------------------------------------
# 9. Security
# --------------------------------------------------------------------------
DISABLE_SSL_VERIFY=false

# --------------------------------------------------------------------------
# 10. Authentication & Multi-User
# --------------------------------------------------------------------------
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_TOKEN_EXPIRE_HOURS=24
AUTH_COOKIE_SECURE=false
NEXT_PUBLIC_AUTH_ENABLED=
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# --------------------------------------------------------------------------
# 11. PocketBase sidecar (Optional auth + storage)
# --------------------------------------------------------------------------
POCKETBASE_URL=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
POCKETBASE_EXTERNAL_URL=

# --------------------------------------------------------------------------
# 12. Storage / Attachments (Optional)
# --------------------------------------------------------------------------
CHAT_ATTACHMENT_DIR=

# --------------------------------------------------------------------------
# Open-TutorAi Legacy Settings (for backward compatibility)
# --------------------------------------------------------------------------
ENABLE_SIGNUP=true
WEBUI_SECRET_KEY=mysecretkey
SUPPRESS_WEBUI_BANNER=true
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ============================================
# Jellyfin 媒体集成（课程点播）
# ============================================
# Jellyfin 服务地址。容器内部署用 http://jellyfin:8096（服务名），
# 本地开发用 http://127.0.0.1:8096。不能用 localhost 当容器内地址！
JELLYFIN_URL=
# Jellyfin 管理后台 → 高级 → API 密钥 生成的 key
JELLYFIN_API_KEY=
# Jellyfin 管理员用户名（用于 PlaybackInfo）
JELLYFIN_USER_ID=
# 课程媒体目录：本地 D:/Media，容器内 /app/media（compose 已挂载）
COURSE_MEDIA_ROOT=
# Jellyfin 中课程库的名称（compose 部署后需手动创建一次：TV Shows 类型）
JELLYFIN_COURSE_LIBRARY=课程库
